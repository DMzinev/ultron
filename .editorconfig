# EditorConfig configuration for Ultron
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web assets, documentation, and configuration files
[*.{js,mjs,cjs,html,css,json,yml,yaml,md}]
indent_size = 2

# Python source code
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# Windows batch files
[*.bat]
end_of_line = crlf
