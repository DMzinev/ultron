#!/bin/sh
# Ultron Git Pre-Commit Hook
# Audits staged Python files for typos and sequence anomalies before committing.

# Find all staged Python files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "[Ultron Hook] Auditing staged Python files..."
ANOMALY_FOUND=0

for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        # Run Ultron audit in JSON mode to catch anomalies
        RESULT=$(python ultron/ultron.py --repo . --check-anomaly "$FILE" --json 2>/dev/null)
        EXIT_CODE=$?
        
        if [ $EXIT_CODE -ne 0 ]; then
            echo "[-] Anomaly detected in $FILE:"
            # Extract and print details using python -c since python is guaranteed to be present
            python -c "
import sys, json
try:
    data = json.loads(sys.argv[1])
    if 'anomalies' in data:
        for anom in data['anomalies']:
            print(f'    - [{anom[\"type\"]}] Line {anom[\"line\"]}: {anom[\"details\"]}')
    else:
        print('    - Error: ' + data.get('error', 'Unknown error'))
except Exception as e:
    print('    - Parse error matching output: ' + str(e))
" "$RESULT"
            ANOMALY_FOUND=1
        fi
    fi
done

if [ $ANOMALY_FOUND -eq 1 ]; then
    echo "[Ultron Hook] Commit rejected! Please fix the anomalies detected above."
    exit 1
fi

echo "[Ultron Hook] All checks passed successfully."
exit 0
