# Ultron Control Plane — Example Environment Configuration
# Copy this file to .env and adjust variables for your local environment.
# Never commit real credentials or private keys to source control.

# Local Web Dashboard Server
ULTRON_PORT=8000
ULTRON_HOST=127.0.0.1
ULTRON_REPO_PATH=.
ULTRON_AUTO_OPEN_BROWSER=false

# Logging & Diagnostic Output (DEBUG, INFO, WARNING, ERROR, CRITICAL)
ULTRON_LOG_LEVEL=INFO

# Code Auditor Sensitivity Threshold (0.10 to 0.95)
ULTRON_TYPO_THRESHOLD=0.75

# MCP Server Settings
ULTRON_MCP_LOG_LEVEL=INFO
